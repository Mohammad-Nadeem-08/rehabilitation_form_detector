# RehabVision AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Path (defaults to backend/rehabvision.db)
DATABASE_PATH=backend/rehabvision.db

# Machine Learning Models Directory
MODELS_DIR=backend/models

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Base URL (used during Vite build/preview)
VITE_API_BASE_URL=http://127.0.0.1:8000
